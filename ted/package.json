    "tax-expert-documents",
    "graphrag",
    "knowledge-graph",
    "ontology",
    "ladybug",
    "mcp",
    "fiscalite",
    "comptabilite",
    "france",
    "data-gouv",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonymarion/ted.git",
    "directory": "ted"
  },
  "bugs": {
    "url": "https://github.com/antonymarion/ted/issues"
  },
  "homepage": "https://www.npmjs.com/package/tax-expert-documents",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "lbug": "^0.14.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3"
  }
