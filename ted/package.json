{
  "name": "tax-expert-documents",
  "version": "0.1.0",
  "description": "Knowledge graph fiscalité française pour agents IA — open data, skills Markdown, LadybugDB, MCP",
  "type": "module",
  "bin": {
    "ted": "./bin/ted.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "skills",
    "company.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "analyze": "node bin/ted.js analyze",
    "mcp": "node bin/ted.js mcp",
    "serve": "node bin/ted.js serve",
    "status": "node bin/ted.js status"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
